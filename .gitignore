# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
**/.utmp/

Library/
Logs/
Temp/
UserSettings/
ProjectSettings/

.DS_Store

# Skip large native libraries with debug symbols
**/Plugins/**/*_d.*

# SpatialBlend native libraries (fetched by tools/fetch_plugins.py).
# The v1 core had the same file name; it is told apart by content, not by this pattern
# (tools/test_no_v1_core_api.py checks installed plugin binaries and headers).
Assets/Plugins/Android/**/libspatialblend*.so*
Assets/Plugins/Linux/libspatialblend*.so*
Assets/Plugins/OSX/libspatialblend*.dylib*
Assets/Plugins/Windows/libspatialblend*.dll*
Assets/Plugins/visionOS/libspatialblend*.dylib*
Assets/Samples/*
**/Supercyan Character Pack Free Sample/
**/Supercyan Character Pack Free Sample.meta
**/Brick Project Studio/
**/Brick Project Studio.meta
**/Meta Avatars SDK/
**/Meta Avatars SDK.meta
**/MetaXR/
**/MetaXR.meta
**/Oculus/
**/Oculus.meta
**/Resources/
**/Resources.meta
# The embodiment data files (structure, measurement, chain) are project data, loaded with Resources.Load; track them.
!Assets/SpatialBlend/Avatar/Embodiment/Resources/
!Assets/SpatialBlend/Avatar/Embodiment/Resources.meta
**/StreamingAssets/
**/StreamingAssets.meta
**/XR/
**/XR.meta
# Track only the XR Management assets the Quest build needs: Android's
# OpenXR loader assignment and the OpenXR feature settings it uses.
!Assets/XR/
!Assets/XR.meta
Assets/XR/*
!Assets/XR/XRGeneralSettingsPerBuildTarget.asset
!Assets/XR/XRGeneralSettingsPerBuildTarget.asset.meta
!Assets/XR/Loaders/
!Assets/XR/Loaders.meta
Assets/XR/Loaders/*
!Assets/XR/Loaders/OpenXRLoader.asset
!Assets/XR/Loaders/OpenXRLoader.asset.meta
!Assets/XR/Settings/
!Assets/XR/Settings.meta
Assets/XR/Settings/*
!Assets/XR/Settings/OpenXR Package Settings.asset
!Assets/XR/Settings/OpenXR Package Settings.asset.meta
**/Photon/
**/Photon.meta
**/TextMesh Pro/
**/TextMesh Pro.meta
**/Dark UI/
**/Dark UI.meta
Assets/SpatialBlend/Samples/NavMeshBakes/
Assets/SpatialBlend/Samples/NavMeshBakes.meta

spatialblend_trace/

# SpatialBlend checksum cache
.spatialblend_checksums

# Crash
*.blob

# Android build output
Android/** 


# crash

mono_crash*

# Editor runs of the scan flow write server outputs here (SessionManager.BuildConfig).
# They are run products and scan data, not project content. Keep them out of git.
Assets/SpatialBlend/Samples/Objects/TestData/*.json
Assets/SpatialBlend/Samples/Objects/TestData/*.glb
Assets/SpatialBlend/Samples/Objects/TestData/*.meta

# The TURN credentials Worker's client secret (tools/turn-credentials-worker). Written by the Editor from
# ~/.config/spatialblend/turn-client-secret; never commit it.
Assets/Resources/SpatialBlendTurnClientSecret*
**/SpatialBlendTurnClientSecret*

# Per-user values written by tools/setup_sdks.py. Templates are in tools/templates; real values never enter git.
# (The Photon settings asset is also covered by **/Photon/ above.)
Assets/Photon/Fusion/Resources/PhotonAppSettings.asset
Assets/Photon/Fusion/Resources/PhotonAppSettings.asset.meta
Assets/Resources/SpatialBlendTurnWorkerUrl*
**/SpatialBlendTurnWorkerUrl*
controlpanel-shots/

# Per-device scan-server config (see docs/local-session-config.md). Never commit one.
spatialblend-local.json
spatialblend-local.json.meta
*.local.json
*.local.json.meta

# The Meta Avatars SDK legs rig (Resources.Load("RTR00003")): Meta sample material, not redistributed here. tools/setup_sdks.py
# copies it from your own package cache (tools/vendor-meta-avatar-legs-rig.py --apply).
Assets/SpatialBlend/Avatar/LegsRig/
Assets/SpatialBlend/Avatar/LegsRig.meta

# Generated by the Editor or by test runs; not project content.
Assets/CompositionLayers/
Assets/CompositionLayers.meta
Assets/Samples.meta
rich-realization-fixtures/
rich-realization-support-fixtures/
